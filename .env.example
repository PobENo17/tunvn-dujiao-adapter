# ---- TUNVN Shop Bot credentials ----
# Your Shop Bot API key: https://tunvnmmo.duckdns.org/api/docs
TUNVN_API_KEY=CHANGE_ME_TUNVN_API_KEY
TUNVN_BASE_URL=https://tunvnmmo.duckdns.org
# usdt (recommended) or vnd
TUNVN_CURRENCY=usdt

# ---- Credentials your Dujiao-Next site will use ----
# Generate strong values: openssl rand -hex 24
ADAPTER_API_KEY=CHANGE_ME_API_KEY
ADAPTER_API_SECRET=CHANGE_ME_API_SECRET

# ---- Runtime ----
LISTEN_ADDR=127.0.0.1:8080
DATA_FILE=data/orders.json
SITE_NAME=TUNVN Shop
PRODUCTS_TTL_SECONDS=60
BUY_TIMEOUT_SECONDS=90
# Fallback callback when the downstream site omits callback_url
DEFAULT_CALLBACK_URL=
